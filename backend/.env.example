# Local development defaults. Copy to backend/.env and set the required values.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# Comma-separated exact browser origins. Do not use a wildcard.
# In production, replace these with the HTTPS origin(s) of the deployed frontend.
# Localhost origins are allowed automatically only outside production.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# COOKIE_SECURE=true is required for HTTPS outside development.
# Production mode automatically adds Secure to the session cookie.
COOKIE_SECURE=false

# Set TRUST_PROXY=true only when the backend is reachable exclusively
# through a trusted reverse proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false

# Maximum JSON request body size (1 MiB).
MAX_JSON_BODY_BYTES=1048576

# MongoDB Atlas
MONGODB_URI=
MONGODB_DB=bms_provenance_dev

# Google Identity Services
GOOGLE_CLIENT_ID=
ADMIN_EMAIL=

# Hyperledger Fabric settings
FABRIC_CHANNEL=mychannel
FABRIC_CHAINCODE=bmsprovenance

# Fabric CLI configuration.
# Defaults are derived from: $HOME/fabric/fabric-samples
# For another host, set FABRIC_SAMPLES_DIR to an absolute path.
FABRIC_SAMPLES_DIR=
FABRIC_BIN_DIR=
FABRIC_CONFIG_PATH=
FABRIC_TEST_NETWORK_DIR=

# Optional overrides; keep Fabric peers/orderer on private interfaces.
FABRIC_ORDERER_ADDRESS=localhost:7050
FABRIC_ORDERER_TLS_HOSTNAME=orderer.example.com
FABRIC_ORG1_PEER_ADDRESS=localhost:7051
FABRIC_ORG2_PEER_ADDRESS=localhost:9051

# Optional absolute certificate overrides. Blank values use sample-network defaults.
FABRIC_ORDERER_CA=
FABRIC_ORG1_PEER_TLS_CERT=
FABRIC_ORG2_PEER_TLS_CERT=

FABRIC_COMMAND_TIMEOUT_MS=60000
FABRIC_WAIT_FOR_EVENT_TIMEOUT=30s
